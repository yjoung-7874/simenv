# simenv/dockerfiles/isaac-ros2/Dockerfile.template
#
# Isaac Sim + ROS 2 통합 시뮬레이션 환경 (버전 매트릭스)
#
# 빌드 인자는 dockerfiles/catalog.yml 이 공급한다. 직접 빌드할 때는
#   docker build --build-arg ISAAC_VERSION=5.0.0 --build-arg ROS_DISTRO=jazzy ...
# 또는 build-matrix.sh 를 사용한다.
#
# 주의 (Isaac Sim 제약)
#   - Isaac Sim 은 자체 Python 런타임을 쓴다 (4.5=3.10, 5.0+=3.11).
#     시스템 ROS 2(Python 3.12)를 그대로 source 하면 rclpy 가 깨진다.
#     → 시스템 ROS 2 는 "외부 노드" 용으로만 두고, 브리지는 Isaac Sim 내장 라이브러리를 쓴다.
#     (DDS 가 전송을 담당하므로 기본 메시지 타입은 이 조합으로 정상 동작)
#   - 커스텀 메시지/패키지를 브리지에서 쓰려면 Python <ISAAC_PYTHON> 용 워크스페이스를
#     별도로 빌드해야 한다 (ROS2_WS_PYTHON 지원은 후속 작업).

ARG ISAAC_VERSION=5.0.0
FROM nvcr.io/nvidia/isaac-sim:${ISAAC_VERSION}

ARG ROS_DISTRO=jazzy
ARG UBUNTU_VERSION=24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}

# ---------------------------------------------------------------------------
# 기본 개발 도구
# ---------------------------------------------------------------------------
RUN sed -i 's@archive.ubuntu.com@mirror.kakao.com@g' /etc/apt/sources.list 2>/dev/null || true \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git wget curl ca-certificates gnupg2 lsb-release \
        bash bash-completion locales vim tmux software-properties-common \
        libglfw3-dev libudev-dev libyaml-cpp-dev libssl-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8

# ---------------------------------------------------------------------------
# ROS 2 (시스템 설치 = 외부 노드용)
#   브리지 자체는 Isaac Sim 내장 라이브러리를 사용한다 (아래 ENV 참조).
# ---------------------------------------------------------------------------
RUN add-apt-repository -y universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
         -o /usr/share/keyrings/ros.key \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros.key] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) main" \
         > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-test-msgs \
        ros-dev-tools \
    && rm -rf /var/lib/apt/lists/*

# 브리지가 Isaac Sim 내장 ROS 라이브러리를 쓰도록 강제한다.
# (시스템 ROS 를 source 하지 않는다 — Python 버전 불일치 방지)
ENV ISAAC_SIM_USE_INTERNAL_ROS=1

# ---------------------------------------------------------------------------
# Isaac Sim 캐시 디렉토리 (컨테이너 사용자 1234 기준, NVIDIA 공식 레이아웃)
#   실제 볼륨은 run 시점에 호스트 디렉토리로 마운트된다.
# ---------------------------------------------------------------------------
RUN mkdir -p /isaac-sim/.cache /isaac-sim/.nv/ComputeCache /isaac-sim/kit/cache \
             /isaac-sim/.nvidia-omniverse/logs /isaac-sim/.nvidia-omniverse/config \
             /isaac-sim/.local/share/ov/data /isaac-sim/.local/share/ov/pkg \
             /workspace \
    && chown -R 1234:1234 /isaac-sim/.cache /isaac-sim/.nv /isaac-sim/kit/cache \
             /isaac-sim/.nvidia-omniverse /isaac-sim/.local/share/ov /workspace

# 시뮬레이션 워크스페이스 (프로젝트/시나리오 마운트 지점)
WORKDIR /workspace

# 기본은 대화형 셸. 실제 실행 모드는 simenv 의 run 스크립트가 결정한다.
CMD ["/bin/bash"]